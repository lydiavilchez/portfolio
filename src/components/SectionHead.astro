---
/**
 * Cabecera de sección estilo "dossier":  § 01 — Sobre mí ........ L.V.L. / 2026
 */
interface Props {
  num: number;
  label: string;
}
const { num, label } = Astro.props;
---

<div class="section-head mono reveal">
  <span><span class="num">§ {String(num).padStart(2, '0')}</span> — {label}</span>
  <span aria-hidden="true">L.V.L. / 2026</span>
</div>
