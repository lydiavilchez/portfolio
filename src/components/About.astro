---
/** 01 · Sobre mí */
import SectionHead from './SectionHead.astro';
import Figurin from './Figurin.astro';
import { content, rich, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].about;
---

<section id="sobre-mi" class="about container" aria-labelledby="about-title">
  <SectionHead num={1} label={t.kicker} />

  <div class="about__grid">
    <h2 id="about-title" class="about__title section-title display reveal" set:html={rich(t.title)} />

    <div class="about__figure">
      <Figurin lang={lang} />
    </div>

    <div class="about__body">
      {t.paragraphs.map((p, i) => <p class="reveal" style={`--delay:${i * 0.08}s`}>{p}</p>)}

      <dl class="facts reveal">
        {
          t.facts.map((f) => (
            <div>
              <dt class="mono">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-space);
  }
  /* Móvil: título → figurín → texto. Escritorio: título y texto a la izquierda, figurín a la derecha */
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    grid-template-areas: 'title' 'figure' 'body';
  }
  .about__title {
    grid-area: title;
    min-width: 0;
  }
  .about__figure {
    grid-area: figure;
  }
  .about__body {
    grid-area: body;
  }
  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'title figure' 'body figure';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
  .about__body {
    display: grid;
    gap: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem);
    max-width: 38rem;
  }
  .about__body p:first-child {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48;
    font-size: 1.35em;
    line-height: 1.3;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .facts > div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .facts dd {
    font-size: 1rem;
  }
</style>
