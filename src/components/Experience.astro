---
/** 02 · Experiencia: Prowler, con contexto y logros */
import SectionHead from './SectionHead.astro';
import { content, plain, rich, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].experience;
---

<section id="experiencia" class="experience container" aria-labelledby="exp-title">
  <SectionHead num={2} label={t.kicker} />

  <div class="experience__grid">
    <!-- Columna izquierda: empresa, rol y fechas (fija al hacer scroll en escritorio) -->
    <header class="experience__head">
      <!-- El rol en grande; la empresa y las fechas debajo -->
      <h2 id="exp-title" class="experience__title display reveal" aria-label={`${plain(t.role)} — ${t.company}`} set:html={rich(t.role)} />
      <p class="experience__meta mono reveal">
        <span>{t.company}</span>
        <span>{t.dates}</span>
      </p>
      <p class="experience__context reveal">{t.context}</p>
      <ul class="tags reveal" aria-label="Stack">
        {t.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </header>

    <!-- Columna derecha: logros -->
    <ol class="highlights">
      {
        t.highlights.map((h, i) => (
          <li class="highlight reveal">
            <span class="highlight__num mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="highlight__title display" set:html={rich(h.title)} />
              <p>{h.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--section-space);
  }
  .experience__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 1000px) {
    .experience__grid {
      grid-template-columns: 1fr 1.25fr;
      align-items: start;
    }
    .experience__head {
      position: sticky;
      top: 7rem;
    }
  }

  .experience__title {
    font-size: clamp(3rem, 7.5vw, 7rem);
    font-weight: 300;
  }
  .experience__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .experience__meta span:last-child {
    color: var(--accent);
  }
  .experience__context {
    margin-block: 1.5rem;
    color: var(--muted);
    max-width: 40ch;
  }

  .highlight {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
  }
  .highlight:last-child {
    border-bottom: 1px solid var(--line);
  }
  .highlight__num {
    color: var(--accent);
    padding-top: 0.5rem;
  }
  .highlight__title {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    line-height: 1;
    margin-bottom: 0.9rem;
  }
  .highlight p {
    color: var(--muted);
    max-width: 52ch;
  }
</style>
