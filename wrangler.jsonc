// Configuración para publicar en Cloudflare (Workers con archivos estáticos).
// La web es estática: Astro la genera en ./dist y Cloudflare la sirve tal cual.
{
  "name": "lydiavilchez",
  "compatibility_date": "2026-10-01",
  // Dominio personalizado. www.lydiavilchez.com redirige aquí con una Redirect Rule
  // configurada en el panel de Cloudflare (no se declara en este archivo).
  "routes": [{ "pattern": "lydiavilchez.com", "custom_domain": true }],
  // Mantiene activa la URL antigua *.workers.dev: al declarar routes, Wrangler la
  // desactiva por defecto si no se indica explícitamente.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
