---
/** 04 · Formación, idiomas y tecnologías */
import SectionHead from './SectionHead.astro';
import { content, rich, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].education;
---

<section id="formacion" class="education container" aria-labelledby="edu-title">
  <SectionHead num={5} label={t.kicker} />
  <h2 id="edu-title" class="section-title display reveal" set:html={rich(t.title)} />

  <ol class="degrees">
    {
      t.degrees.map((d) => (
        <li class="degree reveal">
          <span class="degree__dates mono">{d.dates}</span>
          <div>
            <h3 class="degree__title display">{d.title}</h3>
            <p class="degree__place">{d.place}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="extras">
    <div class="reveal">
      <h3 class="extras__title mono">{t.languagesTitle}</h3>
      <ul class="langs">
        {
          t.languages.map((l) => (
            <li>
              <span>{l.name}</span>
              <span class="mono">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal" style="--delay:.1s">
      <h3 class="extras__title mono">{t.techTitle}</h3>
      <dl class="tech">
        {
          t.tech.map((g) => (
            <div>
              <dt class="mono">{g.label}</dt>
              <dd>{g.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .education {
    padding-block: var(--section-space);
  }
  .education .section-title {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .degree {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line);
  }
  .degree:last-child {
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .degree {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
    }
  }
  .degree__dates {
    color: var(--accent);
  }
  .degree__title {
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .degree__place {
    color: var(--muted);
  }

  .extras {
    display: grid;
    gap: 3rem;
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 900px) {
    .extras {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .extras__title {
    color: var(--muted);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .langs li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
  }
  .langs .mono {
    color: var(--accent);
  }

  .tech > div {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .tech dt {
    color: var(--accent);
  }
  .tech dd {
    font-size: 1.05rem;
    line-height: 1.5;
  }
</style>
